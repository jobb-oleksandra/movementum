{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"trailingSlash": false,
	"redirects": [
		{
			"source": "/:path*",
			"has": [{ "type": "host", "value": "movementum.no" }],
			"destination": "https://www.movementum.no/:path*",
			"permanent": true
		},
		{ "source": "/index.html", "destination": "/", "permanent": true },
		{ "source": "/privacy-policy", "destination": "/personvern.html", "permanent": true },
		{ "source": "/pages/privacy-policy", "destination": "/personvern.html", "permanent": true },
		{ "source": "/personvern", "destination": "/personvern.html", "permanent": true },
		{ "source": "/retreat", "destination": "/retreat.html", "permanent": true },
		{ "source": "/store", "destination": "https://www.movementum.shop/", "permanent": false },
		{ "source": "/store/:path*", "destination": "https://www.movementum.shop/", "permanent": false },
		{ "source": "/offers/:path*", "destination": "https://www.movementum.shop/", "permanent": false }
	],
	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{ "key": "X-Content-Type-Options", "value": "nosniff" },
				{ "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
				{ "key": "X-Frame-Options", "value": "SAMEORIGIN" },
				{ "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
				{ "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" }
			]
		},
		{
			"source": "/assets/(.*)",
			"headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
		}
	]
}
