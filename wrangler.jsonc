// Cloudflare Workers – statisk nettsted med en liten omdirigering (src/index.js).
// Publiser med: npm run deploy
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "movementum",
	"main": "src/index.js",
	"compatibility_date": "2025-09-01",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// Behold adressene som de er (retreat.html forblir retreat.html).
		"html_handling": "none",
		"not_found_handling": "404-page",
		// Workeren må se alle forespørsler for å kunne sende movementum.no -> www.
		"run_worker_first": true
	},
	"routes": [
		{ "pattern": "www.movementum.no", "custom_domain": true },
		{ "pattern": "movementum.no", "custom_domain": true }
	]
}
